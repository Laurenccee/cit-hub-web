{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "duplicates": {
    "minOccurrences": 3
  },
  "ignoreExports": [
    // shadcn/ui kit: generated components intentionally expose their full API surface
    { "file": "src/components/ui/**", "exports": ["*"] }
  ],
  "ignoreDependencies": [
    // Build-time only: imported via `@import "shadcn/tailwind.css"` in app/globals.css
    "shadcn"
  ],
  "boundaries": {
    "zones": [
      { "name": "ui", "patterns": ["src/components/ui/**"] },
      { "name": "features", "patterns": ["src/features/**"] },
      { "name": "app", "patterns": ["app/**"] }
    ],
    "rules": [
      { "from": "ui", "allow": [] },
      { "from": "features", "allow": ["ui", "features"] }
    ]
  },
  "rules": {}
}
